# Backend environment — api.chamathdilshan.dev
# Copy to .env and fill in. Never commit .env.

APP_ENV=development
APP_DEBUG=false
PUBLIC_SITE_URL=http://localhost:3000
NEXT_APP_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000

# Database — Supabase PostgreSQL
DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Storage — Supabase Storage
MEDIA_STORAGE_URL=
MEDIA_STORAGE_KEY=
MEDIA_STORAGE_SECRET=
MEDIA_STORAGE_BUCKET=media

# GitHub OAuth — owner-only admin access (SECURITY.md §5)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OWNER_ID=
GITHUB_OWNER_USERNAME=ChamathDilshanC
GITHUB_OAUTH_REDIRECT_URI=http://localhost:8000/api/auth/github/callback

# Sessions
SESSION_SECRET=
SESSION_COOKIE_NAME=pf_session
SESSION_MAX_AGE=86400

# Caching (CACHING.md §17)
REDIS_URL=redis://localhost:6379/0
CACHE_NAMESPACE=pf:v1
CACHE_DEFAULT_TTL=3600
CACHE_ENABLED=true

# Shared secret for calling the frontend's /api/revalidate
CACHE_REVALIDATE_SECRET=

# Optional CDN purge
CDN_PURGE_URL=
CDN_PURGE_TOKEN=

# Rate limiting (SECURITY.md §20)
RATE_LIMIT_PUBLIC=100/minute
RATE_LIMIT_CONTACT=5/hour
RATE_LIMIT_AUTH=10/minute
RATE_LIMIT_ADMIN=300/minute
RATE_LIMIT_UPLOAD=20/hour

# Observability
LOG_LEVEL=info
SENTRY_DSN=
