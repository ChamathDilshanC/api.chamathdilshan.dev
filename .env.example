# Backend environment — api.chamathdilshan.dev
# Copy to .env and fill in. Never commit .env.

APP_ENV=development
APP_DEBUG=false
PUBLIC_SITE_URL=http://localhost:3000
NEXT_APP_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000

# Database — Supabase PostgreSQL in production (use the session pooler, port 5432):
#   postgresql+asyncpg://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Local development can use SQLite:
DATABASE_URL=sqlite+aiosqlite:///./dev.db

# Admin sign-in — Google + emailed code (SECURITY.md §4)
# Only this Google account can sign in. Optionally pin its immutable Google id
# ("sub", logged in the audit log on first sign-in) so a recycled address fails.
ADMIN_EMAIL=chamathdilshan.dev@gmail.com
ADMIN_GOOGLE_SUB=

# Google Cloud Console → APIs & Services → Credentials → OAuth client (Web application)
#   Authorised redirect URI: <API URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# Resend — sends the 6-digit sign-in code and contact-form messages.
# RESEND_FROM must be on a domain verified in Resend. Without a key,
# development logs the code and messages to the console.
RESEND_API_KEY=
RESEND_FROM=chamathdilshan.dev <auth@chamathdilshan.dev>
OTP_TTL_SECONDS=600
OTP_MAX_ATTEMPTS=5
OTP_MAX_SENDS=4
OTP_RESEND_COOLDOWN_SECONDS=30

# Contact form — the inbox that receives messages (Reply-To is the visitor).
# Leave empty to use ADMIN_EMAIL.
CONTACT_TO=

# Sessions — generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=
SESSION_COOKIE_NAME=pf_session
SESSION_MAX_AGE=86400
# Leave unset: Secure cookies everywhere except APP_ENV=development.
# SESSION_COOKIE_SECURE=

# Media — Cloudinary (Dashboard → API Keys). Images and videos upload straight
# from the admin's browser; the API only signs uploads and verifies them.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=chamathdilshan.dev
CLOUDINARY_SIGNATURE_ALGORITHM=sha1

# Caching (CACHING.md §17). Without Redis set CACHE_ENABLED=false.
REDIS_URL=redis://localhost:6379/0
CACHE_NAMESPACE=pf:v1
CACHE_DEFAULT_TTL=3600
CACHE_ENABLED=true

# Shared secret for calling the frontend's /api/revalidate
CACHE_REVALIDATE_SECRET=

# Optional CDN purge
CDN_PURGE_URL=
CDN_PURGE_TOKEN=

# Rate limiting per IP (SECURITY.md §20)
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_CONTACT_PER_HOUR=5

# Observability
LOG_LEVEL=info
SENTRY_DSN=
